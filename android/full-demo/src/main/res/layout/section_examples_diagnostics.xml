<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <Button android:id="@+id/examples_toggle" style="@style/DisclosureButton" android:text="@string/examples_expand" />
    <LinearLayout style="@style/InsetPanel" android:id="@+id/examples_panel" android:visibility="gone">
        <TextView style="@style/FieldLabel" android:text="@string/pixel_example_label" android:labelFor="@id/pixel_example" />
        <Spinner android:id="@+id/pixel_example" style="@style/Selector" />
        <TextView style="@style/HelpText" android:text="@string/pixel_example_help" />
        <Button android:id="@+id/print_fifo" style="@style/SecondaryButton" android:text="@string/print_fifo" android:enabled="false" />
        <TextView style="@style/HelpText" android:text="@string/print_fifo_help" />
    </LinearLayout>
    <LinearLayout android:id="@+id/print_requests_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
        <TextView style="@style/Section" android:text="@string/print_requests_title" />
        <TextView style="@style/HelpText" android:text="@string/print_requests_help" />
        <LinearLayout android:id="@+id/print_requests" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:saveEnabled="false" />
    </LinearLayout>
    <Button android:id="@+id/diagnostics_toggle" style="@style/DisclosureButton" android:text="@string/diagnostics_expand" />
    <LinearLayout style="@style/InsetPanel" android:id="@+id/diagnostics_panel" android:visibility="gone">
        <TextView android:id="@+id/identity" style="@style/HelpText" android:saveEnabled="false" />
        <Button android:id="@+id/query_status" style="@style/SecondaryButton" android:text="@string/query_status" />
        <Button android:id="@+id/capabilities" style="@style/SecondaryButton" android:text="@string/query_capabilities" />
        <TextView android:id="@+id/last_result" style="@style/HelpText" android:textIsSelectable="true" android:saveEnabled="false" />
        <TextView android:id="@+id/connection_result" style="@style/HelpText" android:textIsSelectable="true" android:saveEnabled="false" />
    </LinearLayout>
</merge>
